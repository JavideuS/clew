<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_coordinator</name>
  <version>0.0.1</version>
  <description>
    Decoupled-mode multi-robot fleet coordinator: calls Spooky for global
    planning, release-gates per-robot dispatch on Spooky's symbolic step
    ordering, and hands each robot's released waypoints to its own local
    planner.
  </description>
  <maintainer email="javi.rm2005@gmail.com">Javier Gonzalez Villasmil</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>python3-requests</depend>
  <depend>python3-yaml</depend>
  <!-- dispatch.py: FollowPath/SmoothPath actions + their message types -->
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>action_msgs</depend>
  <!-- coordinator_node.py: TF convergence gate for the sim initial-pose seed -->
  <depend>tf2_ros</depend>
  <depend>tf2_ros_py</depend>
  <depend>tf2_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
